<div class="layout layout--row layout--left layout--center lg:p--10">
  <div class="columns" data-overflow-cols="3" data-overflow="true" data-overflow-counter="true">
    <div class="column">
      {% render "rlist", reminders: reminders, show_details: true, version: version %}
    </div>
  </div>
  <div class="hidden sm:hidden md:hidden lg:flex flex--col gap--medium">
    <div class="item w--36">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--medium">{{ reminders.size }}</span>
        <span class="label">Reminders</span> 
      </div>
    </div>
    <div class="item w--36">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--small">{{ data_time }}</span>
        <span class="label">Last Refresh</span> 
      </div>
    </div>
  </div>
</div>

{% render "titlebar", list_name: list_name, data_time: data_time %}
